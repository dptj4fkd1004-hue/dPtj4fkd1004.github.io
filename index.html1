<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Umbrella Illustration</title>
    <style>
        :root {
            --bg-color: #cbe6f7;
            --umbrella-red: #d32f2f;
            --umbrella-white: #f5f5f5;
            --stick-color: #795548;
            --handle-color: #3e2723;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            font-family: 'Arial', sans-serif;
            overflow: hidden;
        }

        h1 {
            color: #1a365d;
            margin-bottom: 5px;
            font-size: 2.5rem;
        }

        .subtitle {
            color: #4a5568;
            margin-top: 0;
            margin-bottom: 40px;
            font-size: 1.2rem;
        }

        /* 우산 전체 컨테이너 */
        .umbrella-container {
            position: relative;
            width: 400px;
            height: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* 우산 꼭대기 팁 */
        .umbrella-top {
            width: 14px;
            height: 30px;
            background-color: var(--handle-color);
            border-radius: 50% 50% 0 0;
            position: absolute;
            top: 15px;
            z-index: 3;
        }

        /* 우산 천 (돔 모양) */
        .umbrella-canopy {
            position: relative;
            width: 360px;
            height: 180px;
            background: linear-gradient(to right, 
                var(--umbrella-red) 0%, var(--umbrella-red) 20%, 
                var(--umbrella-white) 20%, var(--umbrella-white) 40%, 
                var(--umbrella-red) 40%, var(--umbrella-red) 60%, 
                var(--umbrella-white) 60%, var(--umbrella-white) 80%, 
                var(--umbrella-red) 80%, var(--umbrella-red) 100%);
            border-radius: 180px 180px 0 0;
            margin-top: 40px;
            overflow: hidden;
            z-index: 2;
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }

        /* 우산 아래쪽 물결 효과 (개별 칸의 곡선미) */
        .canopy-bottom-waves {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 30px;
            display: flex;
            z-index: 3;
        }

        .wave {
            flex: 1;
            height: 30px;
            background-color: var(--bg-color); /* 배경색과 맞춰 파낸 효과 */
            border-radius: 50% 50% 0 0;
            transform: translateY(15px);
        }

        /* 우산 대 (손잡이 봉) */
        .umbrella-stick {
            width: 10px;
            height: 150px;
            background-color: var(--stick-color);
            position: absolute;
            top: 210px;
            z-index: 1;
        }

        /* 우산 J자 손잡이 */
        .umbrella-handle {
            width: 60px;
            height: 50px;
            border: 12px solid var(--handle-color);
            border-top: none;
            border-radius: 0 0 40px 40px;
            position: absolute;
            top: 345px;
            left: 145px; /* 대 위치에 맞게 조절 */
            z-index: 1;
        }
    </style>
</head>
<body>

    <h1>My CSS Umbrella Illustration</h1>
    <p class="subtitle">index.html</p>

    <div class="umbrella-container">
        <!-- 우산 꼭대기 핀 -->
        <div class="umbrella-top"></div>
        
        <!-- 우산 천 (빨강/흰색 스트라이프) -->
        <div class="umbrella-canopy">
            <!-- 아래쪽을 둥글게 파내기 위한 물결 layer -->
            <div class="canopy-bottom-waves">
                <div class="wave"></div>
                <div class="wave"></div>
                <div class="wave"></div>
                <div class="wave"></div>
                <div class="wave"></div>
            </div>
        </div>
        
        <!-- 우산 대 -->
        <div class="umbrella-stick"></div>
        
        <!-- J자형 손잡이 -->
        <div class="umbrella-handle"></div>
    </div>

</body>
</html>
